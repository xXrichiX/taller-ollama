# Copia este archivo a .env y edita los valores antes de desplegar.
#   cp .env.example .env

# --- Base de datos (obligatorio en producción) ---
MYSQL_ROOT_PASSWORD=change-me-use-a-long-random-password
MYSQL_APP_PASSWORD=change-me-another-long-random-password
MYSQL_USER=iespro_app
MYSQL_DATABASE=iespro_taller_app

# --- URL pública del taller (producción) ---
PUBLIC_URL=https://tu-dominio-o-sslip.io
PUBLIC_DOMAIN=tu-dominio-o-sslip.io
TLS_SAN_IP=0.0.0.0
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Registro de usuarios ---
REGISTRATION_ENABLED=0
REGISTRATION_INVITE_CODE=

# --- Cloudflare Turnstile (CAPTCHA en registro) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Modelos Ollama ---
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Seguridad API (producción) ---
TRUST_PROXY_HEADERS=1
SESSION_IDLE_SECONDS=86400
MAX_TOOL_CALLS_PER_TURN=8
# Opcional: pegar PEM en una línea con \n
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=

# --- Límites anti-DoS (opcional) ---
MAX_SUCURSALES_PER_OWNER=5
MAX_ISLAS_PER_SUCURSAL=12
