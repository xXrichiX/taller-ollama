# HTTP sigue sirviendo la app (no redirige) para que nunca "muera" el sitio.
# HTTPS usa certificado autofirmado con la IP del servidor (micrófono).

{
	admin off
}

:80 {
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

:443 {
	tls /etc/certs/server.crt /etc/certs/server.key
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
