# HTTPS automático (Let's Encrypt) en el dominio sslip.io del servidor.
# El micrófono del navegador SOLO funciona en HTTPS con certificado válido.
#
# Ejemplo IP 200.234.226.167 → dominio 200-234-226-167.sslip.io
# Usa: https://200-234-226-167.sslip.io

{
	email {$ACME_EMAIL}
	admin off
}

# HTTP por IP (sin micrófono) — respaldo directo por IP
:80 {
	@domain host {$PUBLIC_DOMAIN}
	handle @domain {
		redir https://{host}{uri} permanent
	}

	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down -Server
		header_down -Via
	}
	header {
		-Server
		-Via
	}
}

# HTTPS con certificado real — usar esta URL para el asistente de voz
{$PUBLIC_DOMAIN} {
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down -Server
		header_down -Via
	}
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
